# Copy to .env (in the folder you run cine from, or in this package folder). Never commit it.

# Text + image model (the brief, cast cards, sheets, boards, keyframes). One of:
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Replicate: the score (ElevenLabs Music), demucs stems, two Whisper transcribers, the speaker check.
REPLICATE_API_TOKEN=

# Video: install the treg CLI and run `treg login` (no key here). Optional overrides:
# CINE_VIDEO_ROUTE=reapi.video-gen.seedance-2-5
# CINE_VIDEO_MODEL=doubao-seedance-2.5-face

# Public storage for references the video model reads (must serve raw bytes over https).
STORAGE_PUBLIC_BASE=          # e.g. https://pub-xxxx.r2.dev or https://your-bucket.s3.amazonaws.com
STORAGE_PREFIX=cine
# Option A: S3-compatible (AWS S3, Cloudflare R2). For R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_ACL=0
# Option B: any upload command with {file} {key} {mime}, e.g.
# STORAGE_UPLOAD_CMD=npx wrangler r2 object put my-bucket/{key} --file {file} --content-type {mime} --remote

# Storyboard image quality: low | medium | high
CINE_IMAGE_QUALITY=high
